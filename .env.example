# Optional. Without a key, Penny runs in offline mode: the detectors still work
# and agents reply with rule-based summaries instead of Claude.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
PENNY_MODEL=
PORT=8787
# Optional starting currency (any ISO code, e.g. EUR, USD, GBP). You can also pick it in the app.
DEFAULT_CURRENCY=
